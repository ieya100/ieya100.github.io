---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for sitemap_page in site.pages %}
  {% if sitemap_page.sitemap != false and sitemap_page.url and sitemap_page.url != '/404.html' %}
  <url>
    <loc>{{ sitemap_page.url | absolute_url | xml_escape }}</loc>
    {% assign sitemap_lang = sitemap_page.lang | default: site.lang | default: 'ru' %}
    <xhtml:link rel="alternate" hreflang="{{ sitemap_lang }}" href="{{ sitemap_page.url | absolute_url | xml_escape }}" />
    {% if sitemap_page.alternate_url %}
      <xhtml:link rel="alternate" hreflang="{% if sitemap_lang == 'en' %}ru{% else %}en{% endif %}" href="{{ sitemap_page.alternate_url | absolute_url | xml_escape }}" />
      <xhtml:link rel="alternate" hreflang="x-default" href="{% if sitemap_lang == 'en' %}{{ sitemap_page.alternate_url | absolute_url | xml_escape }}{% else %}{{ sitemap_page.url | absolute_url | xml_escape }}{% endif %}" />
    {% else %}
      <xhtml:link rel="alternate" hreflang="x-default" href="{{ sitemap_page.url | absolute_url | xml_escape }}" />
    {% endif %}
  </url>
  {% endif %}
{% endfor %}
</urlset>

